# Application Port & Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Python Integration (Optional override)
# Set when Python is not automatically resolved via 'python' or 'py' on Windows / 'python3' on macOS/Linux.
# Windows examples: python, py, C:\Users\<Username>\AppData\Local\Programs\Python\Python310\python.exe
# Linux / macOS examples: python3, /usr/bin/python3
PYTHON_EXECUTABLE=

# GEMINI_API_KEY: Optional/Platform key for Gemini AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Self-referential URL
APP_URL="http://localhost:3000"
